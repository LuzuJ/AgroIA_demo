# ==============================================================================
# Configuración de Entorno - AgriEcuador
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API DE PRECIOS DEL MERCADO (Obligatorio para la vista de precios)
# ------------------------------------------------------------------------------
# Dado que no existe una API pública del MAG/SIPA, usamos un JSON remoto.
# Instrucciones:
# 1. Crea un archivo JSON público (en GitHub Gist, JSONBin, Mocky, etc.)
# 2. Pega la URL directa aquí.
# 
# Ejemplo de formato JSON requerido:
# [
#   {
#     "id": "1",
#     "productName": "Cacao Fino de Aroma",
#     "region": "Guayas",
#     "price": 120.50,
#     "unit": "qq",
#     "trend": "up",
#     "source": "SIPA"
#   }
# ]
VITE_PRICES_API_URL=https://api.myjson.online/v1/records/tu-id-de-json

# ------------------------------------------------------------------------------
# 2. CLAVES DE APIS EXTERNAS (Opcionales)
# ------------------------------------------------------------------------------
# Si decides implementar otras APIs más adelante, colócalas aquí.
# VITE_WEATHER_API_KEY=tu_clave_api
